<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pantri.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pantri</item>
    </style>

    <style name="Theme.Pantri" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pantri_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
